      "id": "b6f569ff-6091-5ff5-8482-d2cd63fe7f69",
      "name": "Read Purchases",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        380
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Look for a purchase with the same phone or email after checkout started\nconst lead = $('Checkout started').first().json.body;\nconst purchases = $input.all().map(i => i.json);\nconst norm = s => String(s || '').replace(/\\D/g, '').slice(-10);\nconst bought = purchases.some(p =>\n  (lead.email && String(p.email || '').toLowerCase() === String(lead.email).toLowerCase()) ||\n  (lead.phone && norm(p.phone) === norm(lead.phone)));\nreturn [{ json: { ...lead, bought } }];"
      },
      "id": "e4a98ab1-e29b-52c9-9de7-0f9008cf75bc",
      "name": "Did they buy?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "894bea02-46b3-43a0-b61b-1a7b708509d4",
              "leftValue": "={{ $json.bought }}",
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1c1b5f52-38e9-5d3b-be54-23b4e929eb88",
      "name": "Not purchased?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        380
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Config').item.json.wa_api_version }}/{{ $('Config').item.json.wa_phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.phone, type: 'template', template: { name: 'checkout_reminder', language: { code: $('Config').item.json.wa_lang }, components: [{ type: 'body', parameters: [{ type: 'text', text: $json.name || 'there' }, { type: 'text', text: $('Config').item.json.checkout_link }] }] } }) }}",
        "options": {}
      },
      "id": "58a04fa4-acfe-5aa9-a2ba-4ba0a049ff34",
      "name": "WhatsApp reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Config').item.json.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "date": "={{ $now.toFormat('yyyy-MM-dd HH:mm') }}",
            "name": "={{ $('Did they buy?').item.json.name }}",
            "email": "={{ $('Did they buy?').item.json.email }}",
            "phone": "={{ $('Did they buy?').item.json.phone }}",
            "source": "checkout",
            "status": "Abandoned - reminded"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "ebf5ca6d-66a5-5c23-aacb-a331aea36eed",
      "name": "Log recovery attempt",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1540,
        300
      ]
    }
