        380
      ],
      "webhookId": "9bd3ed2b-2e07-447b-a81b-b561092a2a1c"
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Config').item.json.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Purchases"
        },
        "options": {}
