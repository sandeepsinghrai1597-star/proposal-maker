            "product": "={{ $('Config').item.json.product_name }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "b67ec8e1-1412-5348-8fde-cb942bf69ac0",
      "name": "Add to Purchases",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Config').item.json.wa_api_version }}/{{ $('Config').item.json.wa_phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $('Verify signature').item.json.phone, type: 'template', template: { name: 'purchase_delivery', language: { code: $('Config').item.json.wa_lang }, components: [{ type: 'body', parameters: [{ type: 'text', text: $('Verify signature').item.json.name || 'there' }, { type: 'text', text: $('Config').item.json.product_name }, { type: 'text', text: $('Config').item.json.delivery_link }] }] } }) }}",
        "options": {}
      },
      "id": "66422591-2ac3-5ece-8953-f3da64a1302f",
      "name": "WhatsApp delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $('Config').item.json.from_email }}",
        "toEmail": "={{ $('Verify signature').item.json.email }}",
        "subject": "=Your {{ $('Config').item.json.product_name }} is here 🎉",
        "emailFormat": "text",
        "text": "=Hi {{ $('Verify signature').item.json.name || 'there' }},\n\nThank you for your purchase (Payment ID {{ $('Verify signature').item.json.payment_id }}).\n\nAccess your product here: {{ $('Config').item.json.delivery_link }}\n\nStart with Chapter 1 today — it takes 15 minutes.\n\n— [Creator Name]",
