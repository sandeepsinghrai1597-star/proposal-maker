      "id": "6943116e-ee4a-53eb-85a1-bb040ffd4d02",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// Verify Razorpay signature: HMAC-SHA256(raw body, webhook secret) must equal x-razorpay-signature\nconst crypto = require('crypto');\nconst secret = $('Config').first().json.razorpay_webhook_secret;\nconst raw = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\nconst sig = $('Razorpay webhook').first().json.headers['x-razorpay-signature'];\nconst body = JSON.parse(raw.toString('utf8'));\nconst p = body?.payload?.payment?.entity || {};\nreturn [{ json: {\n  valid: sig === expected && body.event === 'payment.captured',\n  event: body.event,\n  payment_id: p.id, amount_inr: (p.amount || 0) / 100,\n  email: p.email, phone: String(p.contact || '').replace(/\\D/g, ''),\n  name: p.notes?.name || p.notes?.full_name || '',\n  notes: p.notes || {}\n} }];"
      },
      "id": "b4724479-e22c-5ed4-b878-0649e73d5a30",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        380
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "b17315a1-9abc-4a43-8131-dd4f0d5cb449",
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3fcdec54-c67d-59a5-9282-fb62fac77eb8",
      "name": "Valid payment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
