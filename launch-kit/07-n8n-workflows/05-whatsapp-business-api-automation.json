    {
      "parameters": {
        "jsCode": "// Extract the first inbound text message from a Meta webhook payload\nconst v = $('WA inbound').first().json.body?.entry?.[0]?.changes?.[0]?.value || {};\nconst m = v.messages?.[0];\nif (!m) return [];   // status updates (delivered/read) — nothing to do\nconst text = (m.text?.body || m.button?.text || '').trim();\nconst t = text.toLowerCase();\nlet intent = 'other';\nif (/price|kitne|cost|fees|rate|₹/.test(t)) intent = 'price';\nelse if (/link|buy|kharid|payment|pay/.test(t)) intent = 'buy';\nelse if (/^(hi|hello|hey|namaste)\\b/.test(t)) intent = 'greeting';\nelse if (/stop|unsubscribe/.test(t)) intent = 'stop';\nreturn [{ json: { from: m.from, name: v.contacts?.[0]?.profile?.name || '', text, intent } }];"
      },
      "id": "2df1a36d-8335-53d1-952b-ba0cc01ecd38",
      "name": "Parse message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        580,
        620
      ]
    },
    {
      "parameters": {
        "jsCode": "const c = $('Config1').first().json;\nconst r = {\n  price: `Hi ${$json.name || ''}! 🙏 Product ki saari details aur price yahan hai: ${c.sales_link}`,\n  buy: `Yeh raha secure payment link: ${c.sales_link} — payment ke turant baad aapko WhatsApp pe access mil jayega.`,\n  greeting: `Namaste ${$json.name || ''}! Main aapki kaise help kar sakta hoon? \"price\" ya \"link\" likhiye, ya apna sawaal bhejiye.`,\n  stop: `Done — aapko ab koi promotional message nahi aayega.`,\n  other: `Thank you! Aapka message mil gaya. Team jaldi reply karegi (usually 12 ghante mein).`\n};\nreturn [{ json: { ...$json, reply: r[$json.intent] } }];"
      },
      "id": "986447e6-2b2c-5a47-bd2b-1163837891f5",
      "name": "Pick reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        620
      ]
    },
    {
