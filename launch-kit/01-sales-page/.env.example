# Copy to .env.local (local) and add the same keys in Vercel > Project > Settings > Environment Variables
# Razorpay Dashboard > Payment Button > create a ₹24,500 button > copy its ID (starts with pl_)
NEXT_PUBLIC_RAZORPAY_BUTTON_ID=pl_XXXXXXXXXXXXXX
# Your Calendly event link, e.g. https://calendly.com/yourname/15min
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/15min
# WhatsApp number in international format without + (for the floating chat button)
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX
