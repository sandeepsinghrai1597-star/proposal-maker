# ---------- FREE LOCAL MODE (default) ----------
# Install Ollama (https://ollama.com), then once:  ollama pull mimo-v2.6:9b
# 8 GB RAM laptop?  use  qwen2.5-coder:7b  instead.
MODEL=mimo-v2.6:9b
OLLAMA_HOST=http://127.0.0.1:11434
# Context window for local models (tokens). 16384 fits 16 GB RAM. Use 8192 on 8 GB RAM.
NUM_CTX=16384

# ---------- OPTIONAL: paid Claude models ----------
# Add a key to also see claude-opus-5-5 / claude-sonnet-5-5 in the model picker.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# low | medium | high | xhigh | max  (for local models: low = no thinking, faster)
EFFORT=high
# A Claude task stops when its cost passes this many USD.
MAX_TASK_USD=3

# ---------- General ----------
# Folder the agent works in (your project / a git clone)
WORKSPACE_DIR=./workspace
# GitHub personal access token (Contents: read & write) to clone private repos and push
GITHUB_TOKEN=
# Password for the web UI (only needed if you open it to other devices/internet)
APP_PASSWORD=
PORT=3000
HOST=127.0.0.1
