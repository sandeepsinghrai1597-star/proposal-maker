# Required: get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Folder the agent works in (your project / a git clone). Default: ./workspace
WORKSPACE_DIR=./workspace

# Model and effort. Opus 5.5 = best coding quality. Sonnet 5.5 = ~half the price.
MODEL=claude-opus-5-5
# low | medium | high | xhigh | max   (high = good default for coding)
EFFORT=high

# Optional: GitHub personal access token (repo scope) so the agent can clone private repos and push
GITHUB_TOKEN=

# Optional: protect the web UI with a password (needed if you deploy it on the internet)
APP_PASSWORD=

# Server
PORT=3000
HOST=127.0.0.1

# Optional: monthly-safety stop. The agent stops a task when its cost passes this many USD.
MAX_TASK_USD=3
